# Copy to `.env` (gitignored) and fill in. For local dev the defaults below match
# the bundled docker-compose Postgres.

DATABASE_URL=postgres://auspex:auspex@localhost:5432/auspex

# Session signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

AUTH_BASE_URL=http://localhost:3000

# Optional: error reporting (off when unset)
# SENTRY_DSN=
