{
  "name": "@auspex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "bunx @better-auth/cli generate --config src/auth/instance.ts --output src/auth/schema.ts -y"
  },
  "dependencies": {
    "@auspex/data": "workspace:*",
    "@auspex/dsl": "workspace:*",
    "@auspex/engine": "workspace:*",
    "@auspex/resolver": "workspace:*",
    "@auspex/schema": "workspace:*",
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.8.0",
    "@scalar/hono-api-reference": "^0.11.3",
    "@sentry/bun": "^10.57.0",
    "better-auth": "^1.6.18",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "postgres": "^3.4.9",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "bun-types": "^1.3.13",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
